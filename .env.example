# ============================================
# CONFIGURACIÓN DE ENTORNO - Centro de Día Proyectar
# ============================================
# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el archivo .env a Git (está en .gitignore).
# ============================================

# --------------------------------------------
# BASE DE DATOS
# --------------------------------------------
# Para desarrollo local con SQLite (no requiere PostgreSQL instalado):
USE_SQLITE=True

# Para desarrollo con PostgreSQL local o producción (Supabase/Render):
# USE_SQLITE=False
# DB_NAME=centro_salud_db
# DB_USER=centro_salud_user
# DB_PASSWORD=tu_password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# --------------------------------------------
# DJANGO
# --------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
# Generá una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# Dominios permitidos (separados por coma)
# En producción: tu-dominio.onrender.com,www.tu-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------
# JWT (SimpleJWT)
# --------------------------------------------
# Tiempo de vida del access token (minutos)
JWT_ACCESS_LIFETIME=60

# Tiempo de vida del refresh token (minutos)
JWT_REFRESH_LIFETIME=1440

# --------------------------------------------
# CORS (si hay frontend separado)
# --------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tu-frontend.com

# --------------------------------------------
# CSRF (producción)
# --------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://tu-api.onrender.com

# --------------------------------------------
# EMAIL (opcional)
# --------------------------------------------
# EMAIL_HOST_USER=tu_email@gmail.com
# EMAIL_HOST_PASSWORD=tu_password_de_aplicacion

# --------------------------------------------
# SUPABASE STORAGE (opcional, solo produccion)
# --------------------------------------------
# USE_SUPABASE_STORAGE=False
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_BUCKET=documentos
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=us-east-1